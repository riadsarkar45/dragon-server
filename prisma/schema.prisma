generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dyeingOrders {
  id            Int      @id @default(autoincrement())
  orderNo       String
  orderQty      String
  yarnType      String
  marketingId   Int
  marketingName String
  user          users    @relation(fields: [marketingId], references: [id])
  createdAt     DateTime @default(now())
  monthName     String
}

model users {
  id        Int            @id @default(autoincrement())
  email     String         @unique
  password  String
  name      String?
  orders    dyeingOrders[]
  createdAt DateTime       @default(now())
}
