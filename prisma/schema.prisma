// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id              Int            @id @default(autoincrement())
  email           String         @unique
  password        String
  name            String
  userRole        String
  userDesignation String
  profilePhotoUrl String
  orders          dyeingOrders[] // relation: one user -> many orders
  createdAt       DateTime       @default(now())
}

model orderedYarn {
  id               Int          @id @default(autoincrement())
  createdAt        DateTime     @default(now())
  yarnTypeId       Int // Remove @unique unless you really need it
  dyeingOrderId    Int
  yarnTypes        String
  dyeingOrder      dyeingOrders @relation(fields: [dyeingOrderId], references: [id])
  yarnType         yarnTypes    @relation(fields: [yarnTypeId], references: [id])
}

model dyeingOrders {
  id            Int      @id @default(autoincrement())
  orderNo       String
  orderQty      String
  userId        Int
  marketingName String
  merchentName  String
  factoryName   String
  dyeingSection String
  monthName     String
  createdAt     DateTime @default(now())

  // relations
  colors       colors[]
  user         users?        @relation(fields: [userId], references: [id])
  orderedYarns orderedYarn[] // ← This is the reverse side of the one-to-many
}

model yarnTypes {
  id           Int           @id @default(autoincrement())
  yarnType     String        @unique
  challanNo    String        @unique
  supplierName String
  receivedQty  String
  createdAt    DateTime      @default(now())
  orderedYarn  orderedYarn[]
}

model colors {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  colors        String
  status        String       @default("NOT RCVD")
  dyeingOrders  dyeingOrders @relation(fields: [dyeingOrderId], references: [id])
  dyeingOrderId Int
}
