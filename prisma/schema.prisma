// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id              Int            @id @default(autoincrement())
  email           String         @unique
  password        String
  name            String
  userRole        String
  userDesignation String
  profilePhotoUrl String
  orders          dyeingOrders[] // relation: one user -> many orders
  createdAt       DateTime       @default(now())
}

model dyeingOrders {
  id            Int      @id @default(autoincrement())
  orderNo       String
  orderQty      String
  yarnType      String
  userId        Int? // nullable now
  marketingName String
  merchentName  String
  factoryName   String
  dyeingSection String
  colors        colors[]
  user          users?   @relation(fields: [userId], references: [id]) // optional relation
  createdAt     DateTime @default(now())
  monthName     String
}

model colors {
  id            Int          @id @default(autoincrement())
  createdAt     DateTime     @default(now())
  colors        String
  status        String       @default("NOT RCVD")
  dyeingOrders  dyeingOrders @relation(fields: [dyeingOrderId], references: [id])
  dyeingOrderId Int
}
